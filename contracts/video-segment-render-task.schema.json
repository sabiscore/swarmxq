{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sabiscore/swarmxq/contracts/video-segment-render-task.schema.json",
  "title": "VideoSegmentRenderTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "segmentId", "prompt", "durationSeconds", "fps", "width", "height", "seed"],
  "properties": {
    "jobId": { "type": "string", "minLength": 1 },
    "segmentId": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "negativePrompt": { "type": "string" },
    "durationSeconds": { "type": "number", "minimum": 1, "maximum": 12 },
    "fps": { "type": "integer", "minimum": 8, "maximum": 30 },
    "width": { "type": "integer", "minimum": 256, "maximum": 1920 },
    "height": { "type": "integer", "minimum": 256, "maximum": 1920 },
    "seed": { "type": "integer", "minimum": 0 },
    "referenceImagePath": { "type": "string" }
  }
}
